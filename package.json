{
  "name": "studyflow",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "front",
    "back"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm run dev -w back\" \"npm run dev -w front\"",
    "db:backup": "node scripts/backup-db.mjs",
    "db:migrate": "npm run db:migrate -w back",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w back",
    "start": "npm run start -w back"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "@types/estree": "1.0.9",
    "rollup": "4.66.0",
    "vue": "3.5.44"
  }
}
